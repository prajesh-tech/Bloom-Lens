# Database configuration (MySQL in prod: mysql+pymysql://user:pass@localhost:3306/bloomlens or SQLite async for dev/test)
DATABASE_URL=sqlite+aiosqlite:///./bloomlens.db

# Google Gemini API Key (for low-confidence Bloom verification fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10

# API Authentication & Security
# Keep shared API keys server-side; never expose them through VITE_ variables.
# API_KEY is for trusted server integrations; browser reviewers use cookie sessions.
API_KEY=
AUTH_ENABLED=false
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=true
LOGIN_RATE_LIMIT_PER_MINUTE=10

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
MAX_REQUEST_BODY_SIZE_MB=21
UPLOAD_RATE_LIMIT_PER_MINUTE=10
RETAIN_UPLOADED_FILES=false
MAX_DOCX_UNCOMPRESSED_SIZE_MB=100
MAX_DOCUMENT_PAGES=100
MAX_EXTRACTED_QUESTIONS=500
MAX_PARALLEL_QUESTION_CLASSIFICATIONS=4

# Bloom Classifier Configuration & Weights
BLOOM_VERIFICATION_THRESHOLD=0.60
BLOOM_WEIGHT_VERB=0.30
BLOOM_WEIGHT_SEMANTIC=0.35
BLOOM_WEIGHT_COGNITIVE=0.25
BLOOM_WEIGHT_STRUCTURE=0.10

# Vector Similarity & Search Configuration
SIMILARITY_THRESHOLD_EXACT=0.95
SIMILARITY_THRESHOLD_SEMANTIC=0.70
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
WARMUP_EMBEDDING_ON_STARTUP=false

# Document OCR Configuration
OCR_LANG=en

# Application Runtime Configuration
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
