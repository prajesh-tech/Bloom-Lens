# Database configuration (MySQL in prod: mysql+pymysql://user:pass@localhost:3306/bloomlens or SQLite async for dev/test)
DATABASE_URL=sqlite+aiosqlite:///./bloomlens.db

# Google Gemini API Key (for low-confidence Bloom verification fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# API Authentication & Security
API_KEY=your_bloomlens_api_key_here
AUTH_ENABLED=true

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# Bloom Classifier Configuration & Weights
BLOOM_VERIFICATION_THRESHOLD=0.80
BLOOM_WEIGHT_VERB=0.30
BLOOM_WEIGHT_SEMANTIC=0.35
BLOOM_WEIGHT_COGNITIVE=0.25
BLOOM_WEIGHT_STRUCTURE=0.10

# Vector Similarity & Search Configuration
SIMILARITY_THRESHOLD_EXACT=0.95
SIMILARITY_THRESHOLD_SEMANTIC=0.80
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
WARMUP_EMBEDDING_ON_STARTUP=false

# Document OCR Configuration
OCR_LANG=en

# Application Runtime Configuration
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
